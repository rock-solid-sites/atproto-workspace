{
  "schema_version": 1,
  "workspace": {
    "name": "ATProto Workspace",
    "repository": "rock-solid-sites/atproto-workspace",
    "visibility": "public",
    "purpose": "Shared governance, research and development index for independently releasable ATProto projects.",
    "status": "bootstrap",
    "charter": "CHARTER.md"
  },
  "source_policy": {
    "default_integration": "reference-only",
    "upstream_ownership_preserved": true,
    "migrate_existing_repositories": false,
    "copy_source_without_review": false,
    "require_explicit_license_and_history_review_before_vendoring": true
  },
  "directories": ["projects", "research", "packages"],
  "registry": "projects/registry.json"
}
